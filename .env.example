# Copy this file to .env and .env.local, then fill in the real values from your Supabase project
# (Project Settings > API, and Project Settings > Database).

# Prisma — use the "Transaction" pooled connection string (port 6543) for DATABASE_URL
# and the "Session"/direct connection string (port 5432) for DIRECT_URL (needed for migrations).
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# Supabase client (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxx"

# Server-only, never expose to the browser (bypasses Row Level Security)
SUPABASE_SERVICE_ROLE_KEY="xxxx"
