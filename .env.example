# Copy this file to .env and .env.local, then fill in the real values from your Supabase project
# (Project Settings > API, and Project Settings > Database).

# Prisma (v7 only needs a single connection string — no more directUrl)
DATABASE_URL="postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres"

# Supabase client (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxx"

# Server-only, never expose to the browser (bypasses Row Level Security)
SUPABASE_SERVICE_ROLE_KEY="xxxx"

# Google Sheets API — service account with read-only access to the
# "AUTORIZACIÓN COMPRAS" spreadsheet (shared with GOOGLE_SHEETS_CLIENT_EMAIL
# as Viewer). Used by the autorizacion-compras module.
GOOGLE_SHEETS_CLIENT_EMAIL="xxxx@xxxx.iam.gserviceaccount.com"
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxx\n-----END PRIVATE KEY-----\n"
