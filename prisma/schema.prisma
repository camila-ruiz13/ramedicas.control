// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Mirrors a row in Supabase's auth.users (id is the same UUID).
// Supabase Auth owns auth.users itself; Prisma only manages this public-schema profile.
model Profile {
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String?
  // Bypasses the Role/permission system entirely: full access + manages
  // users and roles. Separate from `roleId` so there's always a way in
  // even if roles/permissions are misconfigured.
  isAdmin   Boolean  @default(false)
  roleId    String?  @db.Uuid
  role      Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tareas    Tarea[]

  @@map("profiles")
}

// Admin-defined job role (e.g. "Supervisor", "Auxiliar de bodega") that
// bundles a set of per-module permissions. A user has at most one Role.
model Role {
  id          String               @id @default(uuid()) @db.Uuid
  name        String               @unique
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  profiles    Profile[]
  permissions RoleModulePermission[]

  @@map("roles")
}

// One row per (role, module) granting view and/or interact (create/edit/delete
// within that module) access. moduleSlug matches a slug in src/lib/modules.ts —
// not a DB foreign key since modules are defined in code, not in the database.
model RoleModulePermission {
  id          String   @id @default(uuid()) @db.Uuid
  roleId      String   @db.Uuid
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  moduleSlug  String
  canView     Boolean  @default(false)
  canInteract Boolean  @default(false)

  @@unique([roleId, moduleSlug])
  @@map("role_module_permissions")
}

// ===== Tareas =====

enum TareaEstado {
  PENDIENTE
  EN_PROGRESO
  COMPLETADA
  CANCELADA
}

model Tarea {
  id              String      @id @default(uuid()) @db.Uuid
  titulo          String
  // Fecha en la que el dueño de la tarea proyecta cerrarla.
  fechaObjetivo   DateTime    @db.Date
  // Se llena solo al marcar la tarea como COMPLETADA — permite comparar
  // contra fechaObjetivo para saber si se cerró a tiempo o tarde.
  fechaCompletada DateTime?   @db.Date
  estado          TareaEstado @default(PENDIENTE)
  profileId       String      @db.Uuid
  profile         Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("tareas")
}

// ===== Cumplimiento documental de proveedores =====
// Mirrors the "PRIMERA FASE" / "SEGUNDA FASE" sheets from the supplier
// compliance Excel. Each import REPLACES the previous snapshot for that
// phase (no history kept) — see ProveedoresImport for the last-import stamp.

enum DocPhase {
  FASE_1
  FASE_2
}

enum DocStatus {
  APROBADO
  RECHAZADO
  NO_APLICA
  SIN_VALIDAR
  NO_SUBIDO
}

model Supplier {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
  documentStatuses DocumentStatus[]

  @@map("suppliers")
}

// Only populated for FASE_2 (product-level documents).
model Product {
  id         String   @id @default(uuid()) @db.Uuid
  code       String
  name       String
  supplierId String   @db.Uuid
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  documentStatuses DocumentStatus[]

  @@unique([code, supplierId])
  @@map("products")
}

// One row per Excel column header (per phase) — lets new required documents
// be added just by adding a column to the Excel, no schema change needed.
model DocumentType {
  id        String    @id @default(uuid()) @db.Uuid
  phase     DocPhase
  name      String
  order     Int
  documentStatuses DocumentStatus[]

  @@unique([phase, name])
  @@map("document_types")
}

// One row per (documentType, supplier|product) cell in the source Excel.
model DocumentStatus {
  id             String       @id @default(uuid()) @db.Uuid
  phase          DocPhase
  documentTypeId String       @db.Uuid
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  supplierId     String?      @db.Uuid
  supplier       Supplier?    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId      String?      @db.Uuid
  product        Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  status         DocStatus

  @@unique([documentTypeId, supplierId, productId])
  @@map("document_statuses")
}

// One row total: timestamp of the last replace-import per phase, shown in
// the upload UI ("última carga: ...").
model ProveedoresImport {
  id         String   @id @default(uuid()) @db.Uuid
  phase      DocPhase @unique
  importedAt DateTime @default(now())
  importedBy String

  @@map("proveedores_imports")
}

// ===== Descuentos y rebates de proveedores =====
// Cruza la paramétrica de ofertas (descuentos/rebates negociados por
// proveedor+código) contra las compras reales de la compañía, mes a mes.
// Fuente: 3 carpetas en Drive con archivos Excel reales (no Google Sheets) —
// COMPRA/ y PREDEVOLUCIONES/ traen un archivo por mes que se acumula: cada
// sincronización relee TODOS los archivos presentes y reemplaza estas tablas
// por completo (igual que Proveedores), agrupando cada fila por su propia
// fecha, no por el nombre del archivo. OFERTAS/ es un solo archivo siempre-
// vigente que también se reemplaza completo en cada sync.

// Una línea de compra (uno por producto dentro de una factura de compra).
model CompraLinea {
  id              String   @id @default(uuid()) @db.Uuid
  mes             String // "2026-07", derivado de fechaFactura
  numero          String // Número de compra, ej. COM019013
  fechaFactura    DateTime @db.Date
  nroFactura      String
  nitProveedor    String
  nombreProveedor String
  codigo          String
  articulo        String
  unidades        Int
  subtotal        Decimal

  @@index([mes, codigo])
  @@index([nitProveedor])
  @@index([numero])
  @@map("compra_lineas")
}

// Una línea de devolución (predevolución) de compra.
model PredevolucionLinea {
  id       String   @id @default(uuid()) @db.Uuid
  mes      String // derivado de fecha
  numero   String // DV002657
  fecha    DateTime @db.Date
  nit      String
  codigo   String
  unidades Int
  docCruce String // Número de la compra original a la que pertenece

  @@index([mes, codigo])
  @@index([docCruce])
  @@map("predevolucion_lineas")
}

// Un acuerdo de descuento vigente: un proveedor (NIT) + un concepto
// (FINANCIERO, COMERCIAL, INFORMACION, LOGISTICO, REBATE...), con su
// vigencia. El id es el propio "ID Oferta" del Excel (ej. "900932340FI").
model Oferta {
  id              String   @id
  nit             String
  nombreProveedor String
  concepto        String
  fechaInicial    DateTime @db.Date
  fechaFinal      DateTime @db.Date
  productos       OfertaProducto[]
  cortes          OfertaCorte[]

  @@index([nit])
  @@map("ofertas")
}

// Períodos de liquidación de una oferta — guardado para referencia, no se
// usa todavía en el cálculo de descuento esperado.
model OfertaCorte {
  id               String   @id @default(uuid()) @db.Uuid
  ofertaId         String
  oferta           Oferta   @relation(fields: [ofertaId], references: [id], onDelete: Cascade)
  corteNumero      Int
  fechaInicioCorte DateTime @db.Date
  fechaFinCorte    DateTime @db.Date

  @@index([ofertaId])
  @@map("oferta_cortes")
}

// El % real por código dentro de una oferta, con su tramo de unidades
// (rango1/rango2) evaluado mes a mes.
model OfertaProducto {
  id          String  @id @default(uuid()) @db.Uuid
  ofertaId    String
  oferta      Oferta  @relation(fields: [ofertaId], references: [id], onDelete: Cascade)
  codArticulo String
  rango1      Decimal
  rango2      Decimal
  porPct      Decimal

  @@index([ofertaId, codArticulo])
  @@map("oferta_productos")
}

// Timestamp de la última sincronización, mostrado en la UI.
model DescuentosImport {
  id         String   @id @default(uuid())
  importedAt DateTime @default(now())
  importedBy String

  @@map("descuentos_imports")
}
